# Copy to .env and adjust if needed.
# Defaults already point at a local Ollama install, free, unlimited, no key needed.
#
# See app/llm_client.py's docstring for ready-to-paste configs for Groq,
# OpenAI, and Nebius Token Factory as alternatives (just three env vars
# change, nothing else in the code does, every option speaks the same
# OpenAI-compatible chat API).

LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b
JOB_AGENT_REQUEST_DELAY=0.5
